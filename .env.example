# Copy to .env (never commit .env). Without a key the app runs in demo mode.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_FALLBACK_MODEL=ministral-8b-latest
# Requests per minute and per visitor (protects your quota once deployed)
REQUESTS_PER_MINUTE=12
# Only if the web page is hosted on another domain (e.g. https://<you>.github.io)
ALLOWED_ORIGINS=
